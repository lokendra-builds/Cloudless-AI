# --- Secrets: never commit ---
.env
.env.*
.streamlit/secrets.toml
*.pem
*.key

# --- SQLite / local databases: never commit ---
*.sqlite
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal
*.db-wal
*.db-shm
db.sqlite3

# --- Virtual environments ---
.venv/
venv/
env/
.python-version

# --- Python build & cache ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
wheels/
pip-wheel-metadata/
*.egg

# --- Tests, coverage & linters ---
.pytest_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.mypy_cache/
.ruff_cache/
.hypothesis/

# --- Notebooks ---
.ipynb_checkpoints/

# --- Logs & temp files ---
*.log
*.tmp
*.bak
*.swp
*~

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# --- Workspace scratch ---
.superpowers/
test-results/

# --- Development notes: task list, scorecard, plans (kept locally, not published) ---
docs/
# Any Markdown written for development (plans, specs, notes); only the README is published
*.md
!/README.md

# --- Banners page: kept locally, not published ---
js/banners.js
js/banner-page.js
css/banners.css

# --- Tests (kept locally, not published) ---
tests/

# --- Local tooling (kept locally, not published) ---
requirements.txt
.github/
build.py
.env.example
CONTRIBUTING.md
deploy.md
